# Quarterdeck — environment variables
# Copy to .env and adjust. None of these are required for local dev.

# Override the backend port (default: 19418, dev: 19419)
# DECK_PORT=19418

# Set to any non-empty value to run in dev mode (port 19419, verbose)
# DECK_DEV=1

# Set to any non-empty value to point the pywebview window at localhost:5173
# DEV=1

# Long-lived local auth token (auto-generated on first run, stored in keychain)
# OSA_KIRO_TOKEN=

# Injected by kiro-cli hooks — do not set manually
# KIRO_SESSION_ID=
